{
  "name": "atlas-developer-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.9.0" },
  "bin": { "atlas": "./scripts/atlas.mjs" },
  "scripts": {
    "atlas": "node scripts/atlas.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3010",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3010",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.5",
    "lucide-react": "^0.564.0",
    "minimatch": "^10.2.4",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.10"
    }
  },
  "packageManager": "pnpm@10.29.3"
}
